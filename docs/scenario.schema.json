{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scam-arena.local/schemas/scenario-v1.json",
  "title": "Scam Arena scenario",
  "description": "Authoring schema for one deterministic, branching Scam Arena scenario.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "version", "status", "title", "category",
    "difficulty", "locale", "summary", "user_context", "persona",
    "start_stage_id", "stages", "red_flags", "scoring", "lesson_summary",
    "created_at", "updated_at", "published_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "published", "archived"]},
    "title": {"type": "string", "minLength": 3, "maxLength": 120},
    "category": {
      "enum": [
        "bank_impersonation", "law_enforcement_impersonation", "fake_prize",
        "fake_investment", "delivery_scam", "account_takeover", "recruitment_scam",
        "fake_payment", "rental_deposit", "loan_scam", "online_marketplace", "other"
      ]
    },
    "difficulty": {"enum": ["beginner", "intermediate", "advanced"]},
    "locale": {"const": "vi-VN"},
    "summary": {"type": "string", "minLength": 10, "maxLength": 500},
    "user_context": {"type": "string", "minLength": 10, "maxLength": 1000},
    "persona": {"$ref": "#/$defs/persona"},
    "start_stage_id": {"$ref": "#/$defs/stageId"},
    "stages": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": {"$ref": "#/$defs/stage"}
    },
    "red_flags": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {"$ref": "#/$defs/redFlag"}
    },
    "scoring": {"$ref": "#/$defs/scoring"},
    "lesson_summary": {"type": "string", "minLength": 10, "maxLength": 1500},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "published_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
  },
  "$defs": {
    "stageId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,49}$"},
    "targetId": {
      "type": "string",
      "pattern": "^(?:[a-z][a-z0-9_-]{0,49}|END_(?:SAFE|UNSAFE|NEUTRAL))$"
    },
    "intent": {
      "enum": ["verify", "refuse", "doubt", "comply", "share_sensitive", "transfer_money", "hang_up", "unknown"]
    },
    "requestedAction": {
      "enum": ["none", "share_sensitive", "transfer_money", "install_app", "click_link", "share_screen", "keep_secret", "other"]
    },
    "persona": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "claimed_role", "speaking_style", "pressure_level"],
      "properties": {
        "name": {"type": "string", "minLength": 2, "maxLength": 80},
        "claimed_role": {"type": "string", "minLength": 2, "maxLength": 120},
        "speaking_style": {"type": "string", "minLength": 5, "maxLength": 300},
        "pressure_level": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["on_intent", "next_stage_id"],
      "properties": {
        "on_intent": {"$ref": "#/$defs/intent"},
        "next_stage_id": {"$ref": "#/$defs/targetId"},
        "admin_note": {"type": "string", "maxLength": 300}
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "objective", "tactics", "requested_action", "opening_line", "fallback_lines",
        "transitions", "default_next_stage_id", "max_turns", "timeout_next_stage_id"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/stageId"},
        "objective": {"type": "string", "minLength": 5, "maxLength": 300},
        "tactics": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 2, "maxLength": 60}},
        "requested_action": {"$ref": "#/$defs/requestedAction"},
        "opening_line": {"type": "string", "minLength": 5, "maxLength": 600},
        "fallback_lines": {
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {"type": "string", "minLength": 3, "maxLength": 600}
        },
        "transitions": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"$ref": "#/$defs/transition"}},
        "default_next_stage_id": {"$ref": "#/$defs/targetId"},
        "max_turns": {"type": "integer", "minimum": 1, "maximum": 10},
        "timeout_next_stage_id": {"$ref": "#/$defs/targetId"}
      }
    },
    "redFlag": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "stage_id", "title", "explanation", "severity"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,49}$"},
        "stage_id": {"$ref": "#/$defs/stageId"},
        "title": {"type": "string", "minLength": 3, "maxLength": 120},
        "explanation": {"type": "string", "minLength": 10, "maxLength": 600},
        "severity": {"enum": ["low", "medium", "high"]}
      }
    },
    "scoreRule": {
      "type": "object", "additionalProperties": false,
      "required": ["intent", "points_delta", "feedback", "critical"],
      "properties": {
        "intent": {"$ref": "#/$defs/intent"},
        "stage_id": {"$ref": "#/$defs/stageId"},
        "points_delta": {"type": "integer", "minimum": -100, "maximum": 100},
        "feedback": {"type": "string", "minLength": 5, "maxLength": 500},
        "critical": {"type": "boolean"}
      }
    },
    "scoring": {
      "type": "object", "additionalProperties": false,
      "required": ["base_score", "rules"],
      "properties": {
        "base_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "rules": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/scoreRule"}}
      }
    }
  }
}
