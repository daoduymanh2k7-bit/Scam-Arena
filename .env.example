# Local Docker Compose defaults only. Use a private, URL-safe password for deployments.
POSTGRES_DB=scam_arena
POSTGRES_USER=scam_arena
POSTGRES_PASSWORD=scam_arena_local_dev

# Default local speech recognition, chosen from the current local comparison.
STT_PROVIDER=faster_whisper
# Cloud recognition: set STT_PROVIDER=deepgram after adding your private key to .env.
# Independent of Gemini/Groq/X-APIKEY text-generation keys; never put this in frontend JS.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=vi
DEEPGRAM_TIMEOUT_SECONDS=15
# Stream call audio while speaking; REST clips remain the fallback/message path.
DEEPGRAM_STREAMING_ENABLED=true
# Growing/repeated REST previews are disabled for Deepgram to avoid duplicate billing.
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
# 3: balanced default; 1: faster experiment; 5: previous decoder setting.
WHISPER_BEAM_SIZE=3
# Live draft subtitles; final text is always decoded separately. Set false to save CPU.
STT_PARTIAL_ENABLED=true
# Optional Gemini API. Copy this file to .env and add your own API key;
# do not commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional paid X-APIKEY fallback, intended after Gemini -> Groq -> OpenRouter.
XAPIKEY_BASE_URL=https://api.x-apikey.com/v1
XAPIKEY_TIMEOUT_SECONDS=15
XAPIKEY_MODEL_TIMEOUT_SECONDS=6

# X-APIKEY for voice calls. Fill in a separate key to track call spending.
XAPIKEY_CALL_API_KEY=
XAPIKEY_CALL_MODEL=gpt-6.1-sol
XAPIKEY_CALL_FALLBACK_MODELS=gpt-6.2-sol,deepseek-v4.1-flash-1017,gpt-6-luna

# X-APIKEY for text messages. Fill in a separate key to track message spending.
XAPIKEY_MESSAGE_API_KEY=
XAPIKEY_MESSAGE_MODEL=gpt-6-luna
XAPIKEY_MESSAGE_FALLBACK_MODELS=gpt-6.1-sol,gpt-6.2-sol,deepseek-v4.1-flash-1017

# Dynamic scammer dialogue (requires a configured provider key).
LINE_LLM_ENABLED=true
DATA_REVIEW_AUTO=true
DATA_REVIEW_TIMEOUT_SECONDS=12
LINE_LLM_TIMEOUT_SECONDS=3
LINE_POOL_SIZE=5
LINE_PROMPT_VERSION=v3

# Local Rasa intent classifier sidecar (Docker Compose internal URL).
RASA_NLU_TIMEOUT_SECONDS=2

# Set true when serving the site over HTTPS.
AUTH_COOKIE_SECURE=false

# LLM conversation memory (requires LINE_LLM_ENABLED and a configured provider).
# Words are counted by whitespace; Vietnamese syllables separated by spaces count separately.
CONVERSATION_SUMMARY_ENABLED=true
CONVERSATION_SUMMARY_MAX_WORDS=150
CONVERSATION_SUMMARY_EVERY_TURNS=4
CONVERSATION_SUMMARY_TIMEOUT_SECONDS=6

# Audio cache is RAM-only (32 MiB, 10 minutes); no personal audio files on disk.
TTS_CACHE_ENABLED=true
TTS_STREAMING_ENABLED=true
TTS_PREWARM_ENABLED=true
